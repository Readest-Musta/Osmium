namespace osmium {
    // Maps an ASCII character (as typed on the physical layout) to the keycode
    // riti expects. Shifted characters map to riti's shifted keycodes.
    i32 keycode_for_char(string ch);
    // Modifier flag for Shift (riti::MODIFIER_SHIFT).
    i32 modifier_shift();
};

dictionary OsSuggestion {
    // Text composed before the currently-being-typed word (previous words).
    string auxiliary;
    // Suggestion candidates for the current word.
    sequence<string> candidates;
    // Index of the currently selected candidate (display index, post-reorder).
    i32 selection;
    // True when there is nothing to compose.
    boolean is_empty;
    // display index -> riti's original candidate index. Passed back to the
    // engine when a candidate is committed so riti learns the right word.
    sequence<i32> original_indices;
};

dictionary GlidePoint {
    f64 x;
    f64 y;
};

dictionary GlideKey {
    string code;
    f64 cx;
    f64 cy;
    f64 half_w;
    f64 half_h;
};

dictionary WordWeight {
    string word;
    f64 weight;
};

dictionary GlideCandidate {
    string word;
    f64 score;
    sequence<string> keys;
};

interface OsGlideDecoder {
    constructor(string database_dir, string user_dir, string layout);
    sequence<GlideCandidate> recognize(
        sequence<GlidePoint> trace,
        sequence<GlideKey> keys,
        sequence<string> context,
        sequence<WordWeight> prior,
        sequence<f64> user_weights
    );
};

interface OsRiti {
    constructor(string database_dir, string user_dir, string layout);

    OsSuggestion suggest_for_key(i32 key, i32 modifier, i32 selection);
    void candidate_committed(i32 index);
    OsSuggestion backspace(boolean ctrl);
    void finish_session();
    boolean is_session_active();
    void update_engine(string database_dir, string user_dir, string layout);
};
